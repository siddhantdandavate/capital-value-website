# Capital Value Mortgage Consulting - Environment Variables Template
# Copy this file to .env.local for local testing, or configure in Netlify dashboard under Site configuration > Environment variables

# Optional: WhatsApp Advisory phone number (with country code, e.g., 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Email Service Credentials for Consultation Form Delivery
# Option A: Resend API (recommended for Netlify / Serverless)
RESEND_API_KEY=

# Option B: Standard SMTP Server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Official recipient for consultation notifications
CONTACT_NOTIFICATION_EMAIL=info@capitalvalue.ae
